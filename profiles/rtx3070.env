# Profile: NVIDIA GeForce RTX 3070 (x86_64, 8GB GDDR6 VRAM)
COMPOSE_PROFILES=rtx3070
PROFILE_NAME=rtx3070

# Storage directory on host
STORAGE_DIR=./data
PORT=8188

# Memory Flags for 8GB VRAM:
# - Offload weights to system RAM to prevent CUDA Out-of-Memory
# - Reserve 2.5GB for activations & attention layers
CLI_ARGS=--listen 0.0.0.0 --port 8188 --reserve-vram 2.5 --lowvram --fp16-vae
