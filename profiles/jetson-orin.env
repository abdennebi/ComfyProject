# Profile: NVIDIA Jetson AGX Orin (aarch64 / ARM64, 32GB Unified LPDDR5 Memory)
COMPOSE_PROFILES=jetson
PROFILE_NAME=jetson-orin

# JetPack L4T release tag (r36.4.0 = JetPack 6.1/6.2; r36.2.0 = JetPack 6.0; r35.4.1 = JetPack 5.1)
JETPACK_TAG=r36.4.0

# Storage directory on host
STORAGE_DIR=./data
PORT=8188

# Memory Flags for 32GB Unified Memory:
# - Jetson shares physical RAM between CPU and Ampere GPU (UMA architecture)
# - DO NOT use --lowvram (would cause unnecessary CPU/GPU swapping and bottleneck speed)
# - --highvram keeps models in unified memory (~16GB for INT8 DiT + Text Encoder + VAE)
# - --reserve-vram 4.0 leaves 4GB for the Linux kernel and background JetPack services
CLI_ARGS=--listen 0.0.0.0 --port 8188 --highvram --reserve-vram 4.0 --fp16-vae
