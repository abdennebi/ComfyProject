# ========================================================
# ComfyUI Qwen-Image-2.1 Configuration
# ========================================================

# Hardware Profile: 'rtx3070' or 'jetson'
# You can also copy directly from profiles/ :
#   cp profiles/rtx3070.env .env
#   cp profiles/jetson-orin.env .env
COMPOSE_PROFILES=rtx3070

# Storage directory on host for models, outputs, and configs
# Default: ./data (within the project folder)
# Set to an absolute path if you have a separate fast drive (e.g. /mnt/storage/comfyui)
STORAGE_DIR=./data

# Port exposed on host
PORT=8188

# ComfyUI command-line arguments:
# For RTX 3070 (8GB VRAM):
# CLI_ARGS="--listen 0.0.0.0 --port 8188 --reserve-vram 2.5 --lowvram --fp16-vae"
# For Jetson AGX Orin 32GB (Unified Memory):
# CLI_ARGS="--listen 0.0.0.0 --port 8188 --highvram --reserve-vram 4.0 --fp16-vae"
CLI_ARGS="--listen 0.0.0.0 --port 8188 --reserve-vram 2.5 --lowvram --fp16-vae"

# JetPack L4T tag for Jetson profile (e.g. r36.4.0 for JetPack 6.1/6.2)
JETPACK_TAG=r36.4.0
